{
  "manifest_version": 3,
  "name": "Claude RTL: Persian/Arabic fix for AI chats",
  "version": "1.1.0",
  "description": "Fixes right-to-left rendering of Persian/Arabic text in Claude, ChatGPT and Grok (messages, responses, and input box).",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-rtl@p-khodadust",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://claude.com/*",
        "https://*.claude.com/*",
        "https://chatgpt.com/*",
        "https://grok.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
